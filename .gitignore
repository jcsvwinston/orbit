# Node dependencies + build scratch for the embedded admin SPA
# (internal/admin/ui). The BUILT output internal/admin/ui/dist IS committed and
# embedded via go:embed (see internal/admin/ui_fallback.go) — do NOT ignore it.
node_modules/
**/node_modules/
*.tsbuildinfo

# Go build / test output
/orbit
*.test
*.out
coverage*.txt

# GoReleaser writes the release archives, SBOMs, checksums and signatures
# here. `goreleaser release --clean` recreates it on every run; nothing in it
# is ever committed.
/dist/

# Editor / OS noise
.DS_Store
*.swp

# The browser bench's own scratch (internal/adminbench/browser): its
# dependencies, the JSON report the Go side reads, and Playwright's traces.
# The specs, the config and the lockfile ARE committed.
internal/adminbench/browser/results.json
internal/adminbench/browser/test-results/
internal/adminbench/browser/playwright-report/
